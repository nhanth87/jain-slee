<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" name="example-jakartaee-helloworld">
    <Appenders>
        <Console name="CONSOLE" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level [%t] %c{1.} - %m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="com.example.helloworld" level="INFO"/>
        <Logger name="com.microjainslee" level="INFO"/>
        <Logger name="SLEE" level="INFO"/>
        <Root level="INFO">
            <AppenderRef ref="CONSOLE"/>
        </Root>
    </Loggers>
</Configuration>
