<?xml version="1.0" encoding="UTF-8"?>
<!--
  micro-jainslee HelloWorld MIN — logging.
  Minimal template: bootstrap + SBB only, no telemetry, no autonomous.
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5p [%t] %c{1.} - %m%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <Logger name="com.microjainslee" level="INFO"/>
        <Logger name="com.example.helloworld" level="INFO"/>
        <Root level="INFO">
            <AppenderRef ref="console"/>
        </Root>
    </Loggers>
</Configuration>
