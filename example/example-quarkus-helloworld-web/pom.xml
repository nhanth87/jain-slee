<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example.helloworld</groupId>
    <artifactId>example-quarkus-helloworld-web</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>micro-jainslee example :: HelloWorld Web (Quarkus CDI + HTTP RA)</name>
    <description>Quarkus 3 CDI host with JAIN SLEE HelloWorld SBB.
        All HTTP is served by ra-http-server (Quarkus HTTP disabled).</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.release>25</maven.compiler.release>
        <quarkus.platform.version>3.37.3</quarkus.platform.version>
        <microjainslee.version>1.2.0-SNAPSHOT</microjainslee.version>
        <surefire.version>3.5.4</surefire.version>
        <quarkus.build.skip>true</quarkus.build.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Quarkus CDI host only — HTTP is ra-http-server -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <!-- JSON for telemetry/monitor handlers (was transitive via quarkus-rest-jackson) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- micro-jainslee -->
        <dependency>
            <groupId>com.microjainslee</groupId>
            <artifactId>jainslee-core</artifactId>
            <version>${microjainslee.version}</version>
        </dependency>
        <dependency>
            <groupId>com.microjainslee</groupId>
            <artifactId>jainslee-api</artifactId>
            <version>${microjainslee.version}</version>
        </dependency>
        <dependency>
            <groupId>com.microjainslee</groupId>
            <artifactId>jainslee-apt</artifactId>
            <version>${microjainslee.version}</version>
            <optional>true</optional>
        </dependency>
        <!-- CDI producers for MicroSleeContainer (required by HelloWorldBootstrap @Inject) -->
        <dependency>
            <groupId>com.microjainslee</groupId>
            <artifactId>adapter-quarkus</artifactId>
            <version>${microjainslee.version}</version>
        </dependency>

        <!-- ra-http-server: HTTP ingress -->
        <dependency>
            <groupId>com.microjainslee</groupId>
            <artifactId>ra-http-server</artifactId>
            <version>${microjainslee.version}</version>
        </dependency>

        <!-- micro-jainslee telemetry + dashboard -->
        <dependency>
            <groupId>com.microjainslee</groupId>
            <artifactId>jainslee-telemetry</artifactId>
            <version>${microjainslee.version}</version>
        </dependency>
        <dependency>
            <groupId>com.microjainslee</groupId>
            <artifactId>jainslee-monitor</artifactId>
            <version>${microjainslee.version}</version>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <version>1.14.0</version>
        </dependency>

        <!-- ra-prometheus-exporter: Vert.x HTTP /metrics endpoint for Prometheus scraping -->
        <dependency>
            <groupId>com.microjainslee</groupId>
            <artifactId>ra-prometheus-exporter</artifactId>
            <version>${microjainslee.version}</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <!-- skip only package-time goals — NOT quarkus:dev (plugin-level
                         skip=true would disable live reload entirely). -->
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                        <configuration>
                            <skip>${quarkus.build.skip}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>25</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.microjainslee</groupId>
                            <artifactId>jainslee-api</artifactId>
                            <version>${microjainslee.version}</version>
                        </path>
                        <path>
                            <groupId>com.microjainslee</groupId>
                            <artifactId>jainslee-apt</artifactId>
                            <version>${microjainslee.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
