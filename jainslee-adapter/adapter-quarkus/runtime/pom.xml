<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.microjainslee</groupId>
        <artifactId>adapter-quarkus-parent</artifactId>
        <version>1.2.2-SNAPSHOT</version>
    </parent>
    <artifactId>adapter-quarkus</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.microjainslee</groupId>
            <artifactId>jainslee-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Optional microservice layer (Infinispan transport). -->
        <dependency>
            <groupId>com.microjainslee</groupId>
            <artifactId>ms-core</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.microjainslee</groupId>
            <artifactId>ms-ispn</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.microjainslee</groupId>
            <artifactId>jainslee-cluster</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <!-- Optional HTTP ingress for MsHttpIngressSupport / MsHttpGatewaySbb. -->
        <dependency>
            <groupId>com.microjainslee</groupId>
            <artifactId>ra-http-server</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-core</artifactId>
            <version>${quarkus.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
            <version>${quarkus.version}</version>
        </dependency>
        <!-- HotReplacementSetup SPI (dev mode only; same pattern as quarkus-vertx-http) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-development-mode-spi</artifactId>
            <version>${quarkus.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer</artifactId>
            <version>${quarkus.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <version>${quarkus.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- The extension descriptor names the deployment artifact by version. Written by hand it went
         stale: the 1.2.0-SNAPSHOT jar still pointed at adapter-quarkus-deployment:1.1.0, Quarkus ran
         the 1.1.0 processor, and a consumer failed with "Unsatisfied dependency for type
         MicroSleeContainer" (RAG core-service, 2026-10-23). Filtered, it follows project.version. -->
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>META-INF/quarkus-extension.properties</include>
                    <include>META-INF/quarkus-extension.yaml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>META-INF/quarkus-extension.properties</exclude>
                    <exclude>META-INF/quarkus-extension.yaml</exclude>
                </excludes>
            </resource>
        </resources>
    </build>
</project>
