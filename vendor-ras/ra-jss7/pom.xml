<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.microjainslee</groupId>
        <artifactId>vendor-ras</artifactId>
        <version>1.2.0-SNAPSHOT</version>
    </parent>
    <artifactId>ra-jss7</artifactId>
    <packaging>jar</packaging>
    <name>micro-jainslee :: RA jSS7 (Generic)</name>
    <description>
        SS7 Resource Adaptor — bridges the RestComm jSS7 stack
        (SCTP → M3UA → SCCP → TCAP → MAP/CAP/INAP) into the micro-jainslee
        SLEE via the 3-port contract. Fires typed MAP/CAP events and generic
        TCAP dialog events; INAP is carried as raw TCAP components (the jSS7
        INAP module ships codecs/primitives only, no provider stack).
    </description>

    <properties>
        <ss7.version>9.2.8-j25</ss7.version>
        <!-- local SCTP (ethiopia-working-dir/sctp) — must match jSS7 coral-valley / ss7-config -->
        <sctp.version>2.27.32</sctp.version>
        <ss7.netty.version>4.2.11.Final</ss7.netty.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.microjainslee</groupId>
            <artifactId>jainslee-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.microjainslee</groupId>
            <artifactId>jainslee-ra-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.microjainslee</groupId>
            <artifactId>jainslee-cluster</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.microjainslee</groupId>
            <artifactId>jainslee-admin-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>

        <!-- ── RestComm jSS7 stack ───────────────────────────────── -->
        <!-- Ss7StackBuilder: JSON-config-driven bootstrap (SCTP→M3UA→SCCP→TCAP→MAP/CAP),
             proven by the jSS7 map/load test harness (USSD + MO/MT-SMS load tests). -->
        <dependency>
            <groupId>org.restcomm.protocols.ss7.config</groupId>
            <artifactId>ss7-config</artifactId>
            <version>${ss7.version}</version>
        </dependency>
        <dependency>
            <groupId>org.restcomm.protocols.ss7.sccp</groupId>
            <artifactId>sccp-api</artifactId>
            <version>${ss7.version}</version>
        </dependency>
        <dependency>
            <groupId>org.restcomm.protocols.ss7.sccp</groupId>
            <artifactId>sccp-impl</artifactId>
            <version>${ss7.version}</version>
        </dependency>
        <dependency>
            <groupId>org.restcomm.protocols.ss7.sccp</groupId>
            <artifactId>sccp-api-ext</artifactId>
            <version>${ss7.version}</version>
        </dependency>
        <dependency>
            <groupId>org.restcomm.protocols.ss7.sccp</groupId>
            <artifactId>sccp-impl-ext</artifactId>
            <version>${ss7.version}</version>
        </dependency>
        <dependency>
            <groupId>org.restcomm.protocols.ss7.m3ua</groupId>
            <artifactId>m3ua-api</artifactId>
            <version>${ss7.version}</version>
        </dependency>
        <dependency>
            <groupId>org.restcomm.protocols.ss7.m3ua</groupId>
            <artifactId>m3ua-impl</artifactId>
            <version>${ss7.version}</version>
        </dependency>
        <dependency>
            <groupId>org.restcomm.protocols.ss7.tcap</groupId>
            <artifactId>tcap-api</artifactId>
            <version>${ss7.version}</version>
        </dependency>
        <dependency>
            <groupId>org.restcomm.protocols.ss7.tcap</groupId>
            <artifactId>tcap-impl</artifactId>
            <version>${ss7.version}</version>
        </dependency>
        <dependency>
            <groupId>org.restcomm.protocols.ss7.map</groupId>
            <artifactId>map-api</artifactId>
            <version>${ss7.version}</version>
        </dependency>
        <dependency>
            <groupId>org.restcomm.protocols.ss7.map</groupId>
            <artifactId>map-impl</artifactId>
            <version>${ss7.version}</version>
        </dependency>
        <dependency>
            <groupId>org.restcomm.protocols.ss7.cap</groupId>
            <artifactId>cap-api</artifactId>
            <version>${ss7.version}</version>
        </dependency>
        <dependency>
            <groupId>org.restcomm.protocols.ss7.cap</groupId>
            <artifactId>cap-impl</artifactId>
            <version>${ss7.version}</version>
        </dependency>
        <dependency>
            <groupId>org.restcomm.protocols.ss7.inap</groupId>
            <artifactId>inap-api</artifactId>
            <version>${ss7.version}</version>
        </dependency>
        <dependency>
            <groupId>org.restcomm.protocols.ss7.inap</groupId>
            <artifactId>inap-impl</artifactId>
            <version>${ss7.version}</version>
        </dependency>

        <!-- ── SCTP transport (Netty) ────────────────────────────── -->
        <dependency>
            <groupId>org.mobicents.protocols.sctp</groupId>
            <artifactId>sctp-api</artifactId>
            <version>${sctp.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mobicents.protocols.sctp</groupId>
            <artifactId>sctp-impl</artifactId>
            <version>${sctp.version}</version>
            <exclusions>
                <!-- Pulls TestNG onto compile CP → Surefire prefers TestNG over JUnit,
                     whose JUnit-mode bridge then reports "Tests run: 0" with BUILD SUCCESS. -->
                <exclusion>
                    <groupId>org.testng</groupId>
                    <artifactId>testng</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.microjainslee</groupId>
            <artifactId>jainslee-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

